# Transcription & Roman Urdu AI (add at least one key in Vercel Environment Variables)
GROQ_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: order of speech providers (e.g. groq,openai,xai)
TRANSCRIBE_PROVIDERS=groq,openai,xai

# Optional: forward creator sign-ups to Google Sheets / Zapier / Make / n8n webhook
LEADS_WEBHOOK_URL=

# Keep false for standalone Vercel deployment (uses Cutline's built-in creator unlock)
VITE_AUTH_ENABLED=false
